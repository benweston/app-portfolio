---
import { Image } from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import { SITE_SUBTITLE, SITE_TITLE } from '../consts';
import lpiLinuxEssentials from '../../assets/icons/linux-essentials-certificate.png';

const pageTitle = `${SITE_TITLE} | Experience`;
const pageDescription =
	'Professional career history, platform and cloud engineering roles, and academic background of Ben Weston.';
---

<PageLayout title={pageTitle} description={pageDescription}>
	<style>
		/* Page Header */
		.page-header {
			margin-bottom: 1.15rem;
		}

		.page-title-row {
			display: flex;
			flex-direction: column;
			align-items: flex-start;
			gap: 0.15rem;
			margin-bottom: 0.45rem;
		}

		.page-title {
			font-size: 2.1rem;
			font-weight: 700;
			margin: 0;
			letter-spacing: -0.02em;
		}

		.page-subtitle {
			font-size: 1.05rem;
			color: var(--accent);
			font-weight: 700;
			margin: 0;
		}

		.page-lead {
			margin: 0;
			font-size: 0.94rem;
			line-height: 1.5;
			color: rgb(var(--gray-dark));
		}

		/* Two-Column Dashboard Grid */
		.experience-grid {
			display: grid;
			grid-template-columns: 1.35fr 1fr;
			gap: 1.5rem;
			align-items: start;
		}

		.experience-col {
			display: flex;
			flex-direction: column;
			gap: 1.25rem;
		}

		section {
			margin: 0;
		}

		.section-header {
			display: flex;
			justify-content: space-between;
			align-items: baseline;
			margin-bottom: 0.7rem;
			border-bottom: 2px solid var(--border-color);
			padding-bottom: 0.35rem;
		}

		.section-header h2 {
			margin: 0;
			font-size: 1.3rem;
		}

		/* Organisation Block */
		.org-group {
			background: var(--bg-surface);
			border: 1px solid var(--border-color);
			border-radius: 10px;
			padding: 0.95rem 1.15rem;
			margin-bottom: 0.85rem;
			box-shadow: 0 2px 8px rgba(0, 0, 0, 4%);
			transition: background-color 0.2s ease, border-color 0.2s ease;
		}

		.org-group:last-child {
			margin-bottom: 0;
		}

		.org-header {
			display: flex;
			flex-wrap: wrap;
			justify-content: space-between;
			align-items: baseline;
			gap: 0.35rem 0.75rem;
			padding-bottom: 0.5rem;
			margin-bottom: 0.75rem;
			border-bottom: 1px solid var(--border-color);
		}

		.org-name {
			font-size: 1.1rem;
			font-weight: 700;
			margin: 0;
			color: rgb(var(--black));
		}

		.org-meta {
			font-size: 0.8rem;
			color: rgb(var(--gray-dark));
			font-weight: 700;
		}

		/* Vertical Timeline */
		.timeline {
			position: relative;
			list-style: none;
			margin: 0;
			padding: 0 0 0 1.35rem;
		}

		.timeline::before {
			content: '';
			position: absolute;
			top: 0.35rem;
			bottom: 0.35rem;
			left: 0.35rem;
			width: 2px;
			background-color: var(--border-color);
		}

		.timeline-item {
			position: relative;
			padding-bottom: 0.85rem;
		}

		.timeline-item:last-child {
			padding-bottom: 0;
		}

		.timeline-marker {
			position: absolute;
			left: -1.35rem;
			top: 0.25rem;
			width: 0.8rem;
			height: 0.8rem;
			border-radius: 50%;
			background-color: var(--bg-surface);
			border: 2.5px solid rgb(var(--gray));
			box-sizing: border-box;
			z-index: 1;
		}

		.timeline-item.current .timeline-marker {
			border-color: var(--accent);
			background-color: var(--accent);
			box-shadow: 0 0 0 3px rgba(35, 55, 255, 0.15);
		}

		:global([data-theme='dark']) .timeline-item.current .timeline-marker {
			box-shadow: 0 0 0 3px rgba(88, 166, 255, 0.2);
		}

		.role-header {
			display: flex;
			flex-wrap: wrap;
			justify-content: space-between;
			align-items: baseline;
			gap: 0.25rem 0.75rem;
			margin-bottom: 0.25rem;
		}

		.role-title {
			font-size: 0.98rem;
			font-weight: 700;
			margin: 0;
			color: rgb(var(--black));
		}

		.role-date {
			font-size: 0.75rem;
			font-weight: 700;
			color: rgb(var(--gray-dark));
			background-color: rgb(var(--gray-light));
			border: 1px solid var(--border-color);
			padding: 0.1rem 0.5rem;
			border-radius: 999px;
			white-space: nowrap;
		}

		.timeline-item.current .role-date,
		.education-card.current .role-date,
		.cert-card-horizontal.current .role-date {
			border-color: var(--accent);
			color: var(--accent);
		}

		.role-summary {
			margin: 0 0 0.45rem 0;
			color: rgb(var(--gray-dark));
			font-size: 0.85rem;
			line-height: 1.45;
		}

		.achievements {
			margin: 0.25rem 0 0.55rem 0;
			padding-left: 1.1rem;
			color: rgb(var(--gray-dark));
			font-size: 0.85rem;
			line-height: 1.45;
		}

		.achievements li {
			margin-bottom: 0.25rem;
		}

		.achievements li:last-child {
			margin-bottom: 0;
		}

		.tag-list {
			display: flex;
			flex-wrap: wrap;
			gap: 0.35rem;
			list-style: none;
			padding: 0;
			margin: 0;
		}

		.tag {
			font-size: 0.72rem;
			background-color: rgb(var(--gray-light));
			color: rgb(var(--gray-dark));
			border: 1px solid var(--border-color);
			padding: 0.15rem 0.5rem;
			border-radius: 4px;
			font-weight: 700;
		}

		/* Education Card */
		.education-card {
			background: var(--bg-surface);
			border: 1px solid var(--border-color);
			border-radius: 10px;
			padding: 0.95rem 1.15rem;
			box-shadow: 0 2px 8px rgba(0, 0, 0, 4%);
			transition: background-color 0.2s ease, border-color 0.2s ease;
		}

		.education-header {
			display: flex;
			flex-wrap: wrap;
			justify-content: space-between;
			align-items: flex-start;
			gap: 0.35rem 0.75rem;
			padding-bottom: 0.5rem;
			margin-bottom: 0.6rem;
			border-bottom: 1px solid var(--border-color);
		}

		.education-institution {
			font-size: 1.1rem;
			font-weight: 700;
			margin: 0 0 0.15rem 0;
			color: rgb(var(--black));
		}

		.education-degree {
			font-size: 0.92rem;
			font-weight: 700;
			color: var(--accent);
			margin: 0;
		}

		.education-card .achievements {
			margin: 0 0 0.65rem 0;
		}

		.education-card .achievements strong {
			color: rgb(var(--black));
		}

		/* Certifications Section */
		.cert-card-horizontal {
			display: flex;
			align-items: center;
			gap: 1.1rem;
			background: var(--bg-surface);
			border: 1px solid var(--border-color);
			border-radius: 10px;
			padding: 0.95rem 1.15rem;
			text-decoration: none;
			box-shadow: 0 2px 8px rgba(0, 0, 0, 4%);
			transition:
				transform 0.15s ease,
				box-shadow 0.15s ease,
				border-color 0.15s ease,
				background-color 0.2s ease;
		}

		.cert-card-horizontal:hover,
		.cert-card-horizontal:focus-visible {
			transform: translateY(-2px);
			box-shadow: var(--box-shadow);
			border-color: var(--accent);
			outline: none;
		}

		.cert-badge-link {
			flex-shrink: 0;
			display: block;
		}

		.cert-badge-img {
			width: 84px;
			height: 84px;
			border-radius: 8px;
			display: block;
			object-fit: contain;
		}

		.cert-content {
			flex: 1;
			min-width: 0;
		}

		.cert-header-row {
			display: flex;
			flex-wrap: wrap;
			justify-content: space-between;
			align-items: baseline;
			gap: 0.35rem 0.75rem;
			margin-bottom: 0.15rem;
		}

		.cert-title {
			font-size: 1.05rem;
			font-weight: 700;
			margin: 0;
			color: rgb(var(--black));
		}

		.cert-issuer {
			font-size: 0.9rem;
			font-weight: 700;
			color: var(--accent);
			margin: 0 0 0.35rem 0;
		}

		.cert-desc {
			font-size: 0.85rem;
			line-height: 1.45;
			color: rgb(var(--gray-dark));
			margin: 0 0 0.55rem 0;
		}

		/* Call to Action Section */
		.cta-section {
			margin-top: 1.35rem;
			padding-top: 1rem;
			border-top: 1px solid var(--border-color);
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			justify-content: space-between;
			gap: 1rem;
		}

		.action-buttons {
			display: flex;
			flex-wrap: wrap;
			gap: 0.6rem;
		}

		.btn {
			display: inline-flex;
			align-items: center;
			gap: 0.4rem;
			padding: 0.45rem 0.95rem;
			border-radius: 8px;
			font-weight: 700;
			text-decoration: none;
			font-size: 0.88rem;
			transition: background-color 0.2s ease, transform 0.1s ease;
		}

		.btn-primary {
			background-color: var(--accent);
			color: #fff;
		}

		.btn-primary:hover {
			background-color: var(--accent-dark);
			color: #fff;
		}

		.btn-secondary {
			background-color: rgb(var(--gray-light));
			color: rgb(var(--black));
			border: 1px solid var(--border-color);
		}

		.btn-secondary:hover {
			background-color: var(--border-color);
			color: rgb(var(--black));
		}

		@media (max-width: 960px) {
			.experience-grid {
				grid-template-columns: 1fr;
			}
		}

		@media (max-width: 640px) {
			.org-group,
			.education-card {
				padding: 1rem;
			}

			.cert-card-horizontal {
				flex-direction: column;
				align-items: flex-start;
				padding: 1rem;
			}

			.role-header,
			.education-header {
				flex-direction: column;
				align-items: flex-start;
				gap: 0.25rem;
			}
		}

		@media (max-width: 480px) {
			.page-title-row {
				flex-direction: column;
				gap: 0.2rem;
			}

			.page-title {
				font-size: 1.95rem;
			}

			.action-buttons {
				width: 100%;
				flex-direction: column;
			}

			.btn {
				justify-content: center;
			}
		}
	</style>

	<div class="page-header">
		<div class="page-title-row">
			<h1 class="page-title">Experience</h1>
			<div class="page-subtitle">{SITE_SUBTITLE}</div>
		</div>
		<p class="page-lead">
			Nearly two decades of experience progressing from technical support into DevOps, cloud, and
			platform engineering across enterprise publishing and technology organisations.
		</p>
	</div>

	<div class="experience-grid">
		<!-- Left Column: Career Progression -->
		<div class="experience-col">
			<section aria-labelledby="career-heading">
				<div class="section-header">
					<h2 id="career-heading">Professional Timeline</h2>
				</div>

				<!-- Springer Nature -->
				<article class="org-group" aria-label="Springer Nature career history">
					<div class="org-header">
						<h3 class="org-name">Springer Nature</h3>
						<div class="org-meta">Full-time · London, United Kingdom</div>
					</div>

					<ol class="timeline">
						<li class="timeline-item current">
							<span class="timeline-marker" aria-hidden="true"></span>
							<div class="role-header">
								<h4 class="role-title">Platform Engineer</h4>
								<span class="role-date">Aug 2026 – Present</span>
							</div>
							<p class="role-summary">
								Designing internal developer platforms (IDPs), self-service toolchains, and
								cloud-native data archival architecture on Google Cloud (Cloud Storage, BigQuery,
								containerised Flask API).
							</p>
							<ul class="tag-list" aria-label="Technologies and focus areas">
								<li class="tag">Go</li>
								<li class="tag">Google Cloud</li>
								<li class="tag">Kubernetes</li>
								<li class="tag">Terraform</li>
							</ul>
						</li>

						<li class="timeline-item">
							<span class="timeline-marker" aria-hidden="true"></span>
							<div class="role-header">
								<h4 class="role-title">Cloud Engineer</h4>
								<span class="role-date">Feb 2024 – Aug 2026 · 2 yrs 7 mos</span>
							</div>
							<p class="role-summary">
								Engineered and sustained highly available, large-scale production environments on
								Google Cloud, modernising legacy infrastructure components to reduce operational
								friction.
							</p>
							<ul class="tag-list" aria-label="Technologies and focus areas">
								<li class="tag">Automation</li>
								<li class="tag">Bash &amp; Shell</li>
								<li class="tag">Google Cloud</li>
								<li class="tag">Terraform</li>
							</ul>
						</li>

						<li class="timeline-item">
							<span class="timeline-marker" aria-hidden="true"></span>
							<div class="role-header">
								<h4 class="role-title">DevOps Engineer</h4>
								<span class="role-date">Apr 2019 – Feb 2024 · 4 yrs 11 mos</span>
							</div>
							<p class="role-summary">
								Delivered operational and optimisation support for CI/CD pipelines using Jenkins and
								AWS, reducing OPEX by $30,000+ by leveraging AWS Trusted Advisor.
							</p>
							<ul class="tag-list" aria-label="Technologies and focus areas">
								<li class="tag">AWS</li>
								<li class="tag">CI/CD Pipelines</li>
								<li class="tag">Cost Optimisation</li>
								<li class="tag">Jenkins</li>
							</ul>
						</li>

						<li class="timeline-item">
							<span class="timeline-marker" aria-hidden="true"></span>
							<div class="role-header">
								<h4 class="role-title">Senior Platform Support Engineer</h4>
								<span class="role-date">Mar 2016 – Apr 2019 · 3 yrs 2 mos</span>
							</div>
							<p class="role-summary">
								Led a two-person engineering team delivering infrastructure and development support,
								and built a self-service Jira Service Desk portal enabling thousands of staff to
								access critical services autonomously.
							</p>
							<ul class="tag-list" aria-label="Technologies and focus areas">
								<li class="tag">Jira Service Desk</li>
								<li class="tag">Linux Administration</li>
								<li class="tag">Platform Support</li>
								<li class="tag">Team Leadership</li>
							</ul>
						</li>

						<li class="timeline-item">
							<span class="timeline-marker" aria-hidden="true"></span>
							<div class="role-header">
								<h4 class="role-title">Head of Service Delivery and Workflow Support</h4>
								<span class="role-date">May 2014 – Mar 2016 · 1 yr 11 mos</span>
							</div>
							<p class="role-summary">
								Led a global team of ~14 engineers (Technical Support Engineers and Senior Software
								Development Tech Leads), implementing structured release planning to deliver ~48
								major software releases in two years.
							</p>
							<ul class="tag-list" aria-label="Technologies and focus areas">
								<li class="tag">Operations Leadership</li>
								<li class="tag">Release Management</li>
								<li class="tag">Service Delivery</li>
								<li class="tag">Workflow Support</li>
							</ul>
						</li>
					</ol>
				</article>
			</section>
		</div>

		<!-- Right Column: Education & Certifications -->
		<div class="experience-col">
			<section aria-labelledby="education-heading">
				<div class="section-header">
					<h2 id="education-heading">Education</h2>
				</div>

				<article class="education-card current">
					<div class="education-header">
						<div>
							<h3 class="education-institution">Keele University</h3>
							<p class="education-degree">Master of Science (MSc), Computer Science</p>
						</div>
						<span class="role-date">Apr 2025 – Jun 2027</span>
					</div>
					<ul class="achievements">
						<li>
							<strong>Key Project:</strong> Developing an open-source application delivery platform
							utilising a modular 'hub &amp; spoke' multi-repo design with automated build, test,
							security, and delivery pipelines.
						</li>
						<li>
							<strong>Academic Focus:</strong> Specialising in Linux &amp; shell languages, Python
							&amp; object-oriented design, developer tooling, and cloud infrastructure.
						</li>
					</ul>
					<ul class="tag-list" aria-label="MSc Modules">
						<li class="tag">Advanced Programming Techniques</li>
						<li class="tag">Design and Programming</li>
						<li class="tag">Fundamentals of Computer Science</li>
						<li class="tag">MSc Project</li>
						<li class="tag">MSc Project Literature Review and Problem Formulation</li>
						<li class="tag">Research and Consultancy Skills</li>
						<li class="tag">Software Engineering with Group Project</li>
						<li class="tag">Statistical Data Analytics and Databases</li>
						<li class="tag">User Interaction Design</li>
						<li class="tag">Web Technologies and Security</li>
					</ul>
				</article>
			</section>

			<section aria-labelledby="certifications-heading">
				<div class="section-header">
					<h2 id="certifications-heading">Certifications</h2>
				</div>

				<a
					href="https://www.credly.com/badges/22bccbcc-ac8d-4aeb-8d26-5c92ffa414ff/public_url"
					target="_blank"
					rel="noopener noreferrer"
					class="cert-card-horizontal current"
				>
					<div class="cert-badge-link">
						<Image
							src={lpiLinuxEssentials}
							alt="Linux Professional Institute - Linux Essentials Certification Badge"
							class="cert-badge-img"
							width={220}
							height={220}
						/>
					</div>
					<div class="cert-content">
						<div class="cert-header-row">
							<h3 class="cert-title">Linux Professional Institute (LPI)</h3>
							<span class="role-date">Verify on Credly ↗</span>
						</div>
						<p class="cert-issuer">Linux Essentials</p>
						<p class="cert-desc">
							Foundational certificate validating core Linux CLI operations, system architecture,
							open-source licensing, shell scripting, and security permissions.
						</p>
						<ul class="tag-list" aria-label="Certification topics">
							<li class="tag">Linux CLI</li>
							<li class="tag">Security &amp; Permissions</li>
							<li class="tag">Shell Scripting</li>
							<li class="tag">System Architecture</li>
						</ul>
					</div>
				</a>
			</section>
		</div>
	</div>

	<div class="cta-section">
		<a href="/" class="btn btn-secondary">← Back to Home</a>
		<div class="action-buttons">
			<a
				href="https://github.com/benweston"
				target="_blank"
				rel="noopener noreferrer"
				class="btn btn-primary"
			>
				GitHub Profile ↗
			</a>
			<a
				href="https://www.linkedin.com/in/westonb26918/"
				target="_blank"
				rel="noopener noreferrer"
				class="btn btn-secondary"
			>
				LinkedIn Profile ↗
			</a>
		</div>
	</div>
</PageLayout>
